# Backend / MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=freelancer_marketplace

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (use your deployed Vercel URL in production)
CLIENT_ORIGIN=https://your-frontend.vercel.app

# Optional payment providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Local development only; Vercel manages the port
PORT=5000
